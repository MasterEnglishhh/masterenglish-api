# Backend local development. Copy to .env; Spring reads it with the local profile.
# Java properties syntax: plain KEY=value, no shell export and no surrounding quotes.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=masterenglish
POSTGRES_USER=masterenglish
POSTGRES_PASSWORD=replace-with-a-random-local-password

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Browser origins: scheme + host + optional port; no paths, trailing slash or wildcard.
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# false for local HTTP; use true for HTTPS deployments.
APP_SECURITY_COOKIE_SECURE=false

# Optional R2 connection. Use a separate development bucket/key when testing locally.
R2_ENABLED=false
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
