# Backend local development. Copy to .env; Spring reads it with the local profile.
# Java properties syntax: plain KEY=value, no shell export and no surrounding quotes.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=masterenglish
POSTGRES_USER=masterenglish
POSTGRES_PASSWORD=replace-with-a-random-local-password

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Browser origins: scheme + host + optional port; no paths, trailing slash or wildcard.
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# false for local HTTP; use true for HTTPS deployments.
APP_SECURITY_COOKIE_SECURE=false

# REQUIRED: generate a different random 64-byte hex key for each entry (never commit .env).
# PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SECRET=
OTP_HMAC_SECRET=
RATE_LIMIT_SECRET=
JWT_ISSUER=masterenglish-api
JWT_ACCESS_TOKEN_DURATION=15m

# Local SMTP capture: docker compose -f compose.local.yaml --profile mail up -d mailpit
# Read captured OTP messages at http://127.0.0.1:8025; nothing is delivered externally.
MAIL_ENABLED=true
MAIL_FROM=no-reply@masterenglish.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL_ENABLE=false
# Uses the HIBP range API with a padded five-character hash-prefix query.
PASSWORD_BREACH_CHECK_ENABLED=true
# For real email: set your provider's host/port/sender/credentials, enable auth and TLS.
# Port 587 generally uses STARTTLS; port 465 uses SSL instead. Follow your provider.

# Optional R2 connection. Use a separate development bucket/key when testing locally.
R2_ENABLED=false
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
